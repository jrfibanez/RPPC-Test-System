# Migration / owner connection (DDL). Never used by the running app.
DATABASE_OWNER_URL=postgres://rppc:rppc_dev@localhost:5432/rppc
# Runtime connection: least-privilege role from spec §7.10 / §8.2.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/rppc
# 32-byte key (base64) for AES-256-GCM of TOTP secrets (§8.5). Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Local file storage root (dev stand-in for the private S3 bucket, §9).
STORAGE_DIR=./storage
# Base URL used in QR verify links on DR / gate pass.
PUBLIC_BASE_URL=http://localhost:3000
